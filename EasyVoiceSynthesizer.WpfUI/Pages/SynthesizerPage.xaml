<Page
    x:Class="EasyVoiceSynthesizer.WpfUI.Pages.SynthesizerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:EasyVoiceSynthesizer.WpfUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:EasyVoiceSynthesizer.ViewModels;assembly=EasyVoiceSynthesizer.ViewModels"
    Title="SynthesizerPage"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    d:DataContext="{d:DesignInstance Type=vm:SynthesizerViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="#2e2e2e"
    mc:Ignorable="d">

    <StackPanel>
        <!--  Page Title  -->
        <TextBlock
            FontSize="34"
            Foreground="White"
            Text="{Binding SynthetizerPageTitle}"
            TextWrapping="Wrap" />

        <!--  user input to synthesize  -->
        <TextBox
            Height="200"
            Margin="10"
            AcceptsReturn="True"
            FontSize="20"
            Foreground="Black"
            MaxLines="20"
            Text="{Binding TextToPlay, UpdateSourceTrigger=PropertyChanged}" />

        <!--  validation button to synthesize and play the sound  -->

        <Grid Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Row="0"
                Grid.Column="1"
                Height="50"
                Margin="0,0,10,0"
                HorizontalAlignment="Center"
                Command="{Binding ShowMeCommand}"
                FontSize="24"
                FontWeight="DemiBold">
                <TextBlock Text="{Binding SynthetizerButtonText}" TextWrapping="Wrap" />
            </Button>


            <Grid
                Grid.Row="0"
                Grid.Column="2"
                IsEnabled="{Binding IsNoPlayingSound}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  1st line Sound Volume  -->
                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Content="{Binding SoundVolumeText}"
                    Foreground="White" />
                <Slider
                    Grid.Row="0"
                    Grid.Column="1"
                    Height="15"
                    VerticalAlignment="Top"
                    Maximum="1.0"
                    Minimum="0.0"
                    Value="{Binding Volume}" />

                <!--  second line  Speech Speed  -->
                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    Content="{Binding SpeedSpeechText}"
                    Foreground="White" />
                <Slider
                    Grid.Row="1"
                    Grid.Column="1"
                    Height="15"
                    VerticalAlignment="Top"
                    Maximum="0.9"
                    Minimum="0.1"
                    Value="{Binding Speed}" />

            </Grid>


        </Grid>
    </StackPanel>
</Page>
